# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every variable the portal uses across all
# phases is listed here; ones marked LATER are unused until that phase lands.
# ---------------------------------------------------------------------------

# --- Database (phase 0) ----------------------------------------------------
# MongoDB Atlas connection string, including the database name.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/ancys-design"

# --- Auth (phase 0) --------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# The portal's own origin. Used for sign-in callbacks and for building the
# public order link that goes out over WhatsApp.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed owner account (phase 0, `npm run seed`) --------------------------
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""

# --- Shop identity, shown on invoices and WhatsApp messages (phase 2) ------
SHOP_NAME="Ancys Design"
SHOP_PHONE="+917306880494"
SHOP_ADDRESS=""

# --- Cloudinary image upload (phase 2) -------------------------------------
# LATER. The API secret is server-only and must never reach the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="ancys-design"

# --- Messaging (phase 3) ---------------------------------------------------
# "manual" builds a wa.me link staff send themselves. "cloud-api" sends through
# Meta. No code outside lib/messaging/ may care which is set.
MESSAGING_PROVIDER="manual"

# --- Reminder cron (phase 4) -----------------------------------------------
# LATER. Bearer token the /api/cron/reminders endpoint requires.
CRON_SECRET=""

# --- WhatsApp Cloud API (phase 5) ------------------------------------------
# LATER. Needs Meta business verification.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Required when self-hosting (npm run start); Vercel sets this for you.
AUTH_TRUST_HOST="true"
